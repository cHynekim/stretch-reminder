{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stretch Reminder",
  "version": "0.2.1",
  "identifier": "com.stretchreminder.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Stretch Reminder",
        "url": "index.html",
        "width": 600,
        "height": 760,
        "minWidth": 460,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1RjlFQkQwRTAwRkRGRTUKUldUbDN3L2cwT3Y1ZFpOaWtZMjM3azkrRGpSeVpMdlc5c2dWdGhmamlKVnRNNDV5dHAvV1h6OTgK",
      "endpoints": ["https://stretch-reminder-community.vercel.app/updates/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
